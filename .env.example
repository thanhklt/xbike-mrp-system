# Root Environment Configuration for Docker Compose
# Copy this file to .env and adjust variables as needed

# Project
PROJECT_NAME=xbike-mrp-system
ENVIRONMENT=development

# Database (PostgreSQL)
POSTGRES_USER=xbike_admin
POSTGRES_PASSWORD=xbike_secure_password_2026
POSTGRES_DB=xbike_mrp
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend API
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:80"]
SECRET_KEY=super-secret-jwt-key-xbike-mrp-2026-production-ready-string-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Nginx
NGINX_PORT=80
