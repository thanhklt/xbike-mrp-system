# Backend Service Environment Variables
PROJECT_NAME="xBike MRP System API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# PostgreSQL Async Database URL
DATABASE_URL="postgresql+asyncpg://xbike_admin:xbike_secure_password_2026@localhost:5432/xbike_mrp"

# Security & JWT Tokens
SECRET_KEY="super-secret-jwt-key-xbike-mrp-2026-production-ready-string-minimum-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Allowed Origins (JSON array format)
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:80", "http://localhost"]
